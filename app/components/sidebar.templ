package components

// NavItem represents a navigation item in the sidebar.
type NavItem struct {
	Route  string
	Label  string
	Icon   string
	Active bool
}

// SidebarProps defines properties for the sidebar component.
type SidebarProps struct {
	Brand       string
	BrandTag    string
	NavItems    []NavItem
	ActiveRoute string
	LogoutURL   string
	SettingsURL string
}

// DefaultNavItems returns the standard navigation items.
func DefaultNavItems(activeRoute string) []NavItem {
	items := []NavItem{
		{Route: "dashboard", Label: "Dashboard", Icon: "dashboard"},
		{Route: "queries", Label: "Queries", Icon: "queries"},
		{Route: "migrations", Label: "Migrations", Icon: "migrations"},
	}
	for i := range items {
		items[i].Active = items[i].Route == activeRoute
	}
	return items
}

// MobileMenuButton renders the hamburger button for mobile navigation.
templ MobileMenuButton() {
	<button
		type="button"
		class="mobile-menu-btn"
		onclick="document.body.classList.add('sidebar-open')"
		aria-label="Open menu"
		aria-expanded="false"
		aria-controls="sidebar"
	>
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
			<line x1="3" y1="6" x2="21" y2="6"/>
			<line x1="3" y1="12" x2="21" y2="12"/>
			<line x1="3" y1="18" x2="21" y2="18"/>
		</svg>
	</button>
}

// SidebarBackdrop renders the backdrop overlay for mobile navigation.
templ SidebarBackdrop() {
	<div
		class="sidebar-backdrop"
		onclick="document.body.classList.remove('sidebar-open')"
		aria-hidden="true"
	></div>
}

// Sidebar renders the application sidebar navigation.
templ Sidebar(props SidebarProps) {
	@SidebarBackdrop()
	<aside class="sidebar" id="sidebar">
		<div class="sidebar__header">
			<button
				type="button"
				class="sidebar__close"
				onclick="document.body.classList.remove('sidebar-open')"
				aria-label="Close menu"
			>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
					<line x1="18" y1="6" x2="6" y2="18"/>
					<line x1="6" y1="6" x2="18" y2="18"/>
				</svg>
			</button>
			<a href="/app/dashboard" class="sidebar__brand">
				<span class="sidebar__brand-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
					</svg>
				</span>
				<div class="sidebar__brand-text">
					<span class="sidebar__brand-name">{ props.Brand }</span>
					if props.BrandTag != "" {
						<span class="sidebar__brand-tag">{ props.BrandTag }</span>
					}
				</div>
			</a>
		</div>

		<nav class="sidebar__nav">
			<ul class="sidebar__menu">
				for _, item := range props.NavItems {
					<li class="sidebar__menu-item">
						<a
							href={ templ.SafeURL("/app/" + item.Route) }
							class={ templ.KV("sidebar__link--active", item.Active), "sidebar__link" }
							if item.Active {
								aria-current="page"
							}
						>
							@sidebarIcon(item.Icon)
							<span class="sidebar__link-text">{ item.Label }</span>
						</a>
					</li>
				}
			</ul>
		</nav>

		<div class="sidebar__footer">
			if props.SettingsURL != "" {
				<a href={ templ.SafeURL(props.SettingsURL) } class="sidebar__link">
					@sidebarIcon("settings")
					<span class="sidebar__link-text">Settings</span>
				</a>
			}
			if props.LogoutURL != "" {
				<form action={ templ.SafeURL(props.LogoutURL) } method="POST" class="sidebar__logout-form">
					<button type="submit" class="sidebar__link sidebar__link--logout">
						@sidebarIcon("logout")
						<span class="sidebar__link-text">Logout</span>
					</button>
				</form>
			}
		</div>
	</aside>
}

// sidebarIcon renders the appropriate icon for a navigation item.
templ sidebarIcon(icon string) {
	<span class="sidebar__icon">
		switch icon {
		case "dashboard":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<rect x="3" y="3" width="7" height="7" rx="1"/>
				<rect x="14" y="3" width="7" height="7" rx="1"/>
				<rect x="3" y="14" width="7" height="7" rx="1"/>
				<rect x="14" y="14" width="7" height="7" rx="1"/>
			</svg>
		case "queries":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<ellipse cx="12" cy="5" rx="9" ry="3"/>
				<path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
				<path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
			</svg>
		case "migrations":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<polyline points="17 1 21 5 17 9"/>
				<path d="M3 11V9a4 4 0 0 1 4-4h14"/>
				<polyline points="7 23 3 19 7 15"/>
				<path d="M21 13v2a4 4 0 0 1-4 4H3"/>
			</svg>
		case "chat":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
			</svg>
		case "review":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
				<polyline points="14 2 14 8 20 8"/>
				<line x1="16" y1="13" x2="8" y2="13"/>
				<line x1="16" y1="17" x2="8" y2="17"/>
				<polyline points="10 9 9 9 8 9"/>
			</svg>
		case "customers":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
				<circle cx="9" cy="7" r="4"/>
				<path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
				<path d="M16 3.13a4 4 0 0 1 0 7.75"/>
			</svg>
		case "products":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
				<polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
				<line x1="12" y1="22.08" x2="12" y2="12"/>
			</svg>
		case "settings":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="3"/>
				<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
			</svg>
		case "logout":
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
				<polyline points="16 17 21 12 16 7"/>
				<line x1="21" y1="12" x2="9" y2="12"/>
			</svg>
		default:
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<circle cx="12" cy="12" r="10"/>
			</svg>
		}
	</span>
}
