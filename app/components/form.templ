package components

// FormFieldProps defines properties for form fields.
type FormFieldProps struct {
	Label       string
	Name        string
	Type        string // text, email, password, number, etc.
	Placeholder string
	Value       string
	Required    bool
	Disabled    bool
	Error       string
	Hint        string
	Class       string
}

// FormFieldDefaults returns a FormFieldProps with sensible defaults.
func FormFieldDefaults() FormFieldProps {
	return FormFieldProps{
		Type: "text",
	}
}

// TextareaProps defines properties for textarea fields.
type TextareaProps struct {
	Label       string
	Name        string
	Placeholder string
	Value       string
	Rows        int
	Required    bool
	Disabled    bool
	Error       string
	Hint        string
	Class       string
}

// SelectOption represents an option in a select dropdown.
type SelectOption struct {
	Value    string
	Label    string
	Selected bool
	Disabled bool
}

// SelectProps defines properties for select fields.
type SelectProps struct {
	Label    string
	Name     string
	Options  []SelectOption
	Required bool
	Disabled bool
	Error    string
	Hint     string
	Class    string
}

// fieldWrapperClasses generates CSS classes for the field wrapper.
func fieldWrapperClasses(hasError bool, class string) string {
	classes := "form-field"
	if hasError {
		classes += " form-field--error"
	}
	if class != "" {
		classes += " " + class
	}
	return classes
}

// FormField renders a complete form field with label, input, and error/hint.
templ FormField(props FormFieldProps) {
	<div class={ fieldWrapperClasses(props.Error != "", props.Class) }>
		if props.Label != "" {
			<label
				for={ props.Name }
				class={ templ.KV("form-field__label--required", props.Required), "form-field__label" }
			>
				{ props.Label }
			</label>
		}
		<input
			type={ props.Type }
			id={ props.Name }
			name={ props.Name }
			placeholder={ props.Placeholder }
			value={ props.Value }
			required?={ props.Required }
			disabled?={ props.Disabled }
			class="form-field__input"
			aria-describedby?={ props.Error != "" || props.Hint != "" }
		/>
		if props.Error != "" {
			<span class="form-field__error" role="alert">{ props.Error }</span>
		}
		if props.Hint != "" && props.Error == "" {
			<span class="form-field__hint">{ props.Hint }</span>
		}
	</div>
}

// TextareaField renders a textarea form field.
templ TextareaField(props TextareaProps) {
	<div class={ fieldWrapperClasses(props.Error != "", props.Class) }>
		if props.Label != "" {
			<label
				for={ props.Name }
				class={ templ.KV("form-field__label--required", props.Required), "form-field__label" }
			>
				{ props.Label }
			</label>
		}
		<textarea
			id={ props.Name }
			name={ props.Name }
			placeholder={ props.Placeholder }
			rows={ intToString(props.Rows) }
			required?={ props.Required }
			disabled?={ props.Disabled }
			class="form-field__input form-field__textarea"
		>{ props.Value }</textarea>
		if props.Error != "" {
			<span class="form-field__error" role="alert">{ props.Error }</span>
		}
		if props.Hint != "" && props.Error == "" {
			<span class="form-field__hint">{ props.Hint }</span>
		}
	</div>
}

// SelectField renders a select dropdown form field.
templ SelectField(props SelectProps) {
	<div class={ fieldWrapperClasses(props.Error != "", props.Class) }>
		if props.Label != "" {
			<label
				for={ props.Name }
				class={ templ.KV("form-field__label--required", props.Required), "form-field__label" }
			>
				{ props.Label }
			</label>
		}
		<select
			id={ props.Name }
			name={ props.Name }
			required?={ props.Required }
			disabled?={ props.Disabled }
			class="form-field__input form-field__select"
		>
			for _, opt := range props.Options {
				<option
					value={ opt.Value }
					selected?={ opt.Selected }
					disabled?={ opt.Disabled }
				>
					{ opt.Label }
				</option>
			}
		</select>
		if props.Error != "" {
			<span class="form-field__error" role="alert">{ props.Error }</span>
		}
		if props.Hint != "" && props.Error == "" {
			<span class="form-field__hint">{ props.Hint }</span>
		}
	</div>
}

// Input renders a standalone input element.
templ Input(props FormFieldProps) {
	<input
		type={ props.Type }
		id={ props.Name }
		name={ props.Name }
		placeholder={ props.Placeholder }
		value={ props.Value }
		required?={ props.Required }
		disabled?={ props.Disabled }
		class={ "form-field__input " + props.Class }
	/>
}

// intToString converts an int to string, defaults to "4" if zero.
func intToString(n int) string {
	if n <= 0 {
		return "4"
	}
	return templ.EscapeString(string(rune('0') + rune(n)))
}
