package pages

import (
    "github.com/JonMunkholm/RevProject1/app/components"
    "github.com/JonMunkholm/RevProject1/app/layout"
)

templ CustomersPage(active string) {
    @layout.LayoutWithAssets(
        "Customers",
        []string{
            "/assets/css/tokens.css",
            "/assets/css/base.css",
            "/assets/css/components.css",
            "/assets/css/pages/app.css",
            "/assets/css/pages/dashboard.css",
        },
        CustomersShell(active),
    )
}

templ CustomersShell(active string) {
    <div class="dashboard-layout">
        @components.Sidebar(components.SidebarProps{
            Brand:       "RevProject",
            BrandTag:    "Operations",
            NavItems:    components.DefaultNavItems(active),
            LogoutURL:   "/auth/logout",
            SettingsURL: "/app/settings",
        })
        @components.MobileMenuButton()

        <main class="dashboard-main">
            <header class="dashboard-header">
                <div class="dashboard-header__info">
                    <h1 class="dashboard-header__title">Customers</h1>
                    <p class="dashboard-header__description">Manage customer accounts and revenue tracking.</p>
                </div>
                <div class="dashboard-header__actions">
                    <button type="button" class="btn btn--primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Add Customer
                    </button>
                </div>
            </header>

            <div class="dashboard-content">
                <div class="dashboard-panel">
                    <div class="dashboard-panel__header">
                        <h2 class="dashboard-panel__title">Customer List</h2>
                        <p class="dashboard-panel__description">All customers in your workspace.</p>
                    </div>
                    <div class="dashboard-panel__body">
                        <table class="dashboard-table" aria-live="polite">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Contracts</th>
                                    <th scope="col">Created</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="5" class="dashboard-table__placeholder">
                                        No customers yet. Add your first customer to get started.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>
}
