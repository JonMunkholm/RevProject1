package pages

import (
    "fmt"
    "net/url"
    "strconv"
    "strings"
    "time"

    "github.com/JonMunkholm/RevProject1/app/layout"
)

type ChatProvider struct {
    ID    string
    Label string
}

type ChatMessageView struct {
    ID        string
    Role      string
    Content   string
    CreatedAt time.Time
}

type ChatConversationView struct {
    ID            string
    Title         string
    Preview       string
    ProviderID    string
    ProviderLabel string
    UpdatedAt     time.Time
    IsActive      bool
}

type ChatConversationChunkProps struct {
    Conversations          []ChatConversationView
    NextOffset             int
    HasMore                bool
    ActiveConversationID   string
    ActiveProviderID       string
}

type ChatPageProps struct {
    Providers              []ChatProvider
    ActiveProviderID       string
    ActiveProviderLabel    string
    ConversationID         string
    Messages               []ChatMessageView
    BlockedReason          string
    ErrorMessage           string
    Conversations          []ChatConversationView
    ConversationsNextOffset int
    ConversationsHasMore    bool
}

type ChatTranscriptProps struct {
    ConversationID string
    Messages       []ChatMessageView
    BlockedReason  string
    ErrorMessage   string
    ProviderID     string
}

templ ChatPage(props ChatPageProps) {
    @layout.LayoutWithAssets(
        "Chat",
        []string{
            "/assets/css/tokens.css",
            "/assets/css/base.css",
            "/assets/css/components.css",
            "/assets/css/pages/chat.css",
        },
        ChatShell(props),
    )
}

templ ChatShell(props ChatPageProps) {
    <div class="chat-layout" id="chat-root">
        <!-- Mobile Menu Button -->
        <button
            type="button"
            class="mobile-menu-btn"
            onclick="document.body.classList.add('sidebar-open')"
            aria-label="Open menu"
        >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="3" y1="6" x2="21" y2="6"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>

        <!-- Sidebar Backdrop -->
        <div
            class="sidebar-backdrop"
            onclick="document.body.classList.remove('sidebar-open')"
            aria-hidden="true"
        ></div>

        <!-- Sidebar -->
        <aside class="chat-sidebar" id="chat-sidebar">
            <div class="chat-sidebar__header">
                <button
                    type="button"
                    class="chat-sidebar__close"
                    onclick="document.body.classList.remove('sidebar-open')"
                    aria-label="Close menu"
                >
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
                <h1 class="chat-sidebar__title">Chat</h1>
                <p class="chat-sidebar__subtitle">AI-powered conversations</p>
            </div>

            <!-- Provider Selection -->
            <div class="chat-providers">
                <div class="chat-providers__label">Provider</div>
                if len(props.Providers) == 0 {
                    <p class="text-sm text-muted">No providers available</p>
                } else {
                    <div class="chat-providers__list">
                        for _, provider := range props.Providers {
                            <button
                                type="button"
                                class={ chatProviderBtnClasses(provider.ID == props.ActiveProviderID) }
                                hx-post="/app/chat/conversations"
                                hx-target="#chat-root"
                                hx-swap="outerHTML"
                                hx-encoding="json"
                                hx-vals={ fmt.Sprintf(`{"provider":"%s"}`, provider.ID) }
                                hx-push-url={ fmt.Sprintf("/app/chat?provider=%s", provider.ID) }
                            >
                                { provider.Label }
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Conversation List -->
            <div class="chat-conversations">
                <div class="chat-conversations__header">
                    <span class="chat-conversations__title">Recent</span>
                </div>
                if len(props.Conversations) == 0 {
                    <div class="chat-conversations__empty">
                        <p>No conversations yet</p>
                        <p class="text-xs mt-1">Send a message to start</p>
                    </div>
                } else {
                    <div class="chat-conversations__list" id="chat-conversation-list">
                        for _, conv := range props.Conversations {
                            @ChatConversationItem(conv)
                        }
                        if props.ConversationsHasMore {
                            @ChatConversationSentinel(props.ConversationsNextOffset, props.ActiveProviderID, props.ConversationID)
                        }
                    </div>
                }
            </div>
        </aside>

        <!-- Main Content -->
        <main class="chat-main">
            <header class="chat-main__header">
                <div class="chat-main__header-info">
                    <h2 class="chat-main__title">{ props.ActiveProviderLabel }</h2>
                    if props.BlockedReason != "" {
                        <p class="chat-main__status text-warning">{ props.BlockedReason }</p>
                    }
                </div>
                <div class="chat-main__actions">
                    <button
                        type="button"
                        class="btn btn--secondary"
                        hx-post="/app/chat/conversations"
                        hx-target="#chat-root"
                        hx-swap="outerHTML"
                        hx-encoding="json"
                        hx-vals={ fmt.Sprintf(`{"provider":"%s"}`, props.ActiveProviderID) }
                    >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        New chat
                    </button>
                </div>
            </header>

            <div id="chat-transcript">
                @ChatTranscript(ChatTranscriptProps{
                    ConversationID: props.ConversationID,
                    Messages: props.Messages,
                    BlockedReason: props.BlockedReason,
                    ErrorMessage: props.ErrorMessage,
                    ProviderID: props.ActiveProviderID,
                })
            </div>
        </main>
    </div>
}

templ ChatConversationItem(conv ChatConversationView) {
    <a
        class={ chatConversationItemClasses(conv.IsActive) }
        href={ templ.SafeURL(conversationPushURL(conv.ProviderID, conv.ID)) }
        hx-get={ conversationLoadURL(conv.ID, conv.ProviderID) }
        hx-target="#chat-root"
        hx-swap="outerHTML"
        hx-push-url={ conversationPushURL(conv.ProviderID, conv.ID) }
    >
        <span class="chat-conversation-item__title">{ conv.Title }</span>
        <span class="chat-conversation-item__meta">
            { conv.ProviderLabel }
            <span>·</span>
            { formatConversationTimestamp(conv.UpdatedAt) }
        </span>
        if conv.Preview != "" {
            <p class="chat-conversation-item__preview">{ conv.Preview }</p>
        }
    </a>
}

templ ChatConversationItems(props ChatConversationChunkProps) {
    for _, conv := range props.Conversations {
        @ChatConversationItem(conv)
    }
    if props.HasMore {
        @ChatConversationSentinel(props.NextOffset, props.ActiveProviderID, props.ActiveConversationID)
    }
}

templ ChatConversationSentinel(offset int, providerID, conversationID string) {
    <div class="chat-conversations__load-more">
        <button
            type="button"
            class="chat-conversations__load-btn"
            hx-get={ conversationListURL(offset, providerID, conversationID) }
            hx-trigger="revealed once, click"
            hx-target="#chat-conversation-list"
            hx-swap="beforeend"
            hx-on::after-request="this.parentElement.remove()"
        >
            Load more
        </button>
    </div>
}

templ ChatTranscript(props ChatTranscriptProps) {
    <div class="chat-transcript">
        if props.ErrorMessage != "" {
            <div class="chat-notice chat-notice--error" role="alert">
                { props.ErrorMessage }
            </div>
        }

        <div class="chat-transcript__messages">
            if len(props.Messages) == 0 {
                <div class="chat-transcript__empty">
                    <svg class="chat-transcript__empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    <p class="chat-transcript__empty-text">Start a conversation by sending a message below</p>
                </div>
            } else {
                <div class="chat-transcript__list">
                    for _, msg := range props.Messages {
                        @ChatMessage(msg)
                    }
                </div>
            }
            <!-- Typing indicator (shown during HTMX requests) -->
            <div class="chat-typing htmx-indicator" id="chat-typing-indicator">
                <div class="chat-message__avatar" style="background-color: var(--success-subtle); color: var(--success);">AI</div>
                <div class="chat-typing__dots">
                    <span class="chat-typing__dot"></span>
                    <span class="chat-typing__dot"></span>
                    <span class="chat-typing__dot"></span>
                </div>
            </div>
        </div>

        if props.BlockedReason != "" {
            <div class="chat-notice chat-notice--warning" role="alert">
                { props.BlockedReason }
            </div>
        } else if props.ConversationID != "" {
            @ChatComposer(props.ConversationID, props.ProviderID)
        }
    </div>
}

templ ChatMessage(msg ChatMessageView) {
    <div class={ chatMessageClasses(msg.Role) }>
        <div class="chat-message__header">
            <div class="chat-message__avatar">
                { avatarInitial(msg.Role) }
            </div>
            <span class="chat-message__role">{ displayRole(msg.Role) }</span>
            <span class="chat-message__time">{ msg.CreatedAt.Format("15:04") }</span>
        </div>
        <div class="chat-message__content">
            <p class="chat-message__text">{ msg.Content }</p>
        </div>
    </div>
}

templ ChatComposer(conversationID, providerID string) {
    <div class="chat-composer">
        <form
            class="chat-composer__wrapper"
            hx-post={ fmt.Sprintf("/app/chat/conversations/%s/messages", conversationID) }
            hx-target="#chat-transcript"
            hx-swap="outerHTML"
            hx-encoding="json"
            hx-indicator="#chat-typing-indicator"
            hx-on::after-request="this.reset()"
            hx-trigger="submit"
            hx-on::init="this.addEventListener('keydown', (event) => { if (event.key === 'Enter' && !event.shiftKey && event.target.tagName === 'TEXTAREA') { event.preventDefault(); htmx.trigger(this, 'submit'); } });"
        >
            <input type="hidden" name="provider" value={ providerID }/>
            <div class="chat-composer__input-wrapper">
                <textarea
                    name="content"
                    class="chat-composer__textarea"
                    placeholder="Type your message..."
                    rows="1"
                    required
                ></textarea>
                <button type="submit" class="chat-composer__submit">
                    <svg class="chat-composer__submit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                    Send
                </button>
            </div>
            <p class="chat-composer__hint">Press Enter to send, Shift+Enter for new line</p>
        </form>
    </div>
}

// Helper functions

func chatProviderBtnClasses(active bool) string {
    if active {
        return "chat-provider-btn chat-provider-btn--active"
    }
    return "chat-provider-btn"
}

func chatConversationItemClasses(active bool) string {
    if active {
        return "chat-conversation-item chat-conversation-item--active"
    }
    return "chat-conversation-item"
}

func conversationLoadURL(conversationID, providerID string) string {
    if strings.TrimSpace(providerID) == "" {
        return fmt.Sprintf("/app/chat/conversations/%s", conversationID)
    }
    return fmt.Sprintf("/app/chat/conversations/%s?provider=%s", conversationID, url.QueryEscape(providerID))
}

func conversationPushURL(providerID, conversationID string) string {
    values := url.Values{}
    if strings.TrimSpace(providerID) != "" {
        values.Set("provider", providerID)
    }
    if strings.TrimSpace(conversationID) != "" {
        values.Set("conversation", conversationID)
    }
    if len(values) == 0 {
        return "/app/chat"
    }
    return "/app/chat?" + values.Encode()
}

func conversationListURL(offset int, providerID, conversationID string) string {
    if offset < 0 {
        offset = 0
    }
    values := url.Values{}
    values.Set("offset", strconv.Itoa(offset))
    if strings.TrimSpace(providerID) != "" {
        values.Set("provider", providerID)
    }
    if strings.TrimSpace(conversationID) != "" {
        values.Set("active", conversationID)
    }
    encoded := values.Encode()
    if encoded == "" {
        return "/app/chat/conversations"
    }
    return "/app/chat/conversations?" + encoded
}

func formatConversationTimestamp(ts time.Time) string {
    if ts.IsZero() {
        return ""
    }
    return ts.Local().Format("Jan 2")
}

func chatMessageClasses(role string) string {
    switch role {
    case "assistant":
        return "chat-message chat-message--assistant"
    case "system":
        return "chat-message chat-message--system"
    default:
        return "chat-message chat-message--user"
    }
}

func displayRole(role string) string {
    switch strings.ToLower(role) {
    case "assistant":
        return "Assistant"
    case "system":
        return "System"
    default:
        return "You"
    }
}

func avatarInitial(role string) string {
    switch strings.ToLower(role) {
    case "assistant":
        return "AI"
    case "system":
        return "S"
    default:
        return "U"
    }
}
